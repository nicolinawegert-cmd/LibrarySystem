@page "/members"
@inject LibraryContext Db

<PageTitle>Medlemmar</PageTitle>

<div class="page-heading">
  <h1>Medlemmar</h1>
  <p>Se medlemsregistret, öppna medlemsdetaljer och registrera nya låntagare.</p>
</div>

<section class="form-shell mb-4">
  <h2 class="section-title">Registrera ny medlem</h2>
  <p class="section-subtitle">Lägg till en ny medlem som direkt blir tillgänglig i utlåningsflödet.</p>

  <EditForm Model="@newMember" OnValidSubmit="HandleAddMember" FormName="AddMemberForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label">Medlemsnummer</label>
        <InputText class="form-control" @bind-Value="newMember.MemberId" />
        <ValidationMessage For="@(() => newMember.MemberId)" />
      </div>

      <div class="col-md-4">
        <label class="form-label">Namn</label>
        <InputText class="form-control" @bind-Value="newMember.Name" />
        <ValidationMessage For="@(() => newMember.Name)" />
      </div>

      <div class="col-md-4">
        <label class="form-label">E-post</label>
        <InputText class="form-control" @bind-Value="newMember.Email" />
        <ValidationMessage For="@(() => newMember.Email)" />
      </div>
    </div>

    <div class="mt-3">
      <button type="submit" class="btn btn-success">Spara medlem</button>
    </div>
  </EditForm>
</section>

@if (!string.IsNullOrWhiteSpace(addMemberMessage))
{
  <div class="alert alert-success" role="alert">
    @addMemberMessage
  </div>
}

@if (!string.IsNullOrWhiteSpace(addMemberError))
{
  <div class="alert alert-danger" role="alert">
    @addMemberError
  </div>
}

@code {
  private List<Member>? members;
  private AddMemberFormModel newMember = new(); 
  private string? addMemberMessage;
  private string? addMemberError;

  private class AddMemberFormModel
  {
    [Required(ErrorMessage = "Medlemsnummer är obligatoriskt.")]
    public string? MemberId { get; set; } = string.Empty;

    [Required(ErrorMessage = "Namn är obligatoriskt.")]
    public string? Name { get; set; } = string.Empty;

    [Required(ErrorMessage = "E-post är obligatorisk.")]
    [EmailAddress(ErrorMessage = "Ogiltig e-postadress")]
    public string Email { get; set; } = string.Empty;
  }

  protected override async Task OnInitializedAsync()
  {
    members = await Db.Members
      .Include(m => m.Loans)
      .OrderBy(m => m.Name)
      .ToListAsync();
  }

  private async Task HandleAddMember()
  {
    addMemberMessage = null;
    addMemberError = null;

    try
    {
      var member = new Member(newMember.MemberId!, newMember.Name!, newMember.Email);

      Db.Members.Add(member);
      await Db.SaveChangesAsync();

      addMemberMessage = "Medlem registrerades.";
      newMember = new AddMemberFormModel(); 

      members = await Db.Members
        .Include(m => m.Loans)
        .OrderBy(m => m.Name)
        .ToListAsync();
    }
    catch (InvalidOperationException ex)
    {
      addMemberError = ex.Message;
    }
    catch (Exception)
    {
      addMemberError = "Ett oväntat fel uppstod när medlemmen skulle sparas.";
    }
  }
}

@if (members == null)
{
  <p>Laddar medlemmar...</p>
}
else if (!members.Any())
{
  <p>Inga medlemmar hittades.</p>
}
else
{
  <section>
    <h2 class="section-title">Medlemslista</h2>

    <div class="table-shell">
      <table class="table">
        <thead>
          <tr>
            <th>Medlemsnummer</th>
            <th>Namn</th>
            <th>E-post</th>
            <th>Aktiva lån</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var member in members)
          {
            <tr>
              <td>@member.MemberId</td>
              <td>
                <a href="/members/@member.Id">@member.Name</a>
              </td>
              <td>@member.Email</td>
              <td>@member.Loans.Count(l => !l.IsReturned)</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
}

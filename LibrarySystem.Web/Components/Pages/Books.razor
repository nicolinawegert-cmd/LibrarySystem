@page "/books"
@inject IBookRepository BookRepository

<PageTitle>Böcker</PageTitle>

<div class="page-heading">
  <h1>Böcker</h1>
  <p>Hantera katalogen, sök fram titlar och uppdatera bibliotekets bestånd.</p>
</div>

<section class="content-panel mb-4">
  <h2 class="section-title">Sök och sortera</h2>
  <p class="section-subtitle">Nuvarande sortering: @currentSortColumn (@(sortAscending ? "Stigande" : "Fallande"))</p>

  <div class="row g-3 align-items-end">
    <div class="col-md-8">
      <label for="searchTerm" class="form-label">Sök bok</label>
      <InputText id="searchTerm" class="form-control" @bind-Value="searchTerm" />
    </div>
    <div class="col-md-4">
      <div class="d-grid gap-2 d-md-flex justify-content-md-end">
        <button class="btn btn-primary" @onclick="HandleSearch">Sök</button>
        <button class="btn btn-secondary" @onclick="LoadAllBooks">Visa alla</button>
      </div>
    </div>
  </div>
</section>

<section class="form-shell mb-4">
  <h2 class="section-title">Lägg till ny bok</h2>
  <p class="section-subtitle">Registrera en ny bok som direkt blir synlig i katalogen.</p>

  <EditForm Model="@newBook" OnValidSubmit="HandleAddBook" FormName="AddBookForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">ISBN</label>
        <InputText class="form-control" @bind-Value="newBook.ISBN" />
        <ValidationMessage For="@(() => newBook.ISBN)" />
      </div>

      <div class="col-md-6">
        <label class="form-label">Titel</label>
        <InputText class="form-control" @bind-Value="newBook.Title" />
        <ValidationMessage For="@(() => newBook.Title)" />
      </div>

      <div class="col-md-6">
        <label class="form-label">Författare</label>
        <InputText class="form-control" @bind-Value="newBook.Author" />
        <ValidationMessage For="@(() => newBook.Author)" />
      </div>

      <div class="col-md-6">
        <label class="form-label">Utgivningsår</label>
        <InputNumber class="form-control" @bind-Value="newBook.PublishedYear" />
        <ValidationMessage For="@(() => newBook.PublishedYear)" />
      </div>
    </div>

    <div class="mt-3">
      <button type="submit" class="btn btn-success">Spara bok</button>
    </div>
  </EditForm>
</section>

@if (isEditingBook)
{
  <section class="form-shell mb-4">
    <h2 class="section-title">Redigera bok</h2>
    <p class="section-subtitle">Uppdatera uppgifterna för vald bok.</p>

    <EditForm Model="@editBook" OnValidSubmit="HandleUpdateBook" FormName="EditBookForm">
      <DataAnnotationsValidator />
      <ValidationSummary />

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">ISBN</label>
          <InputText class="form-control" @bind-Value="editBook.ISBN" />
          <ValidationMessage For="@(() => editBook.ISBN)" />
        </div>

        <div class="col-md-6">
          <label class="form-label">Titel</label>
          <InputText class="form-control" @bind-Value="editBook.Title" />
          <ValidationMessage For="@(() => editBook.Title)" />
        </div>

        <div class="col-md-6">
          <label class="form-label">Författare</label>
          <InputText class="form-control" @bind-Value="editBook.Author" />
          <ValidationMessage For="@(() => editBook.Author)" />
        </div>

        <div class="col-md-6">
          <label class="form-label">Utgivningsår</label>
          <InputNumber class="form-control" @bind-Value="editBook.PublishedYear" />
          <ValidationMessage For="@(() => editBook.PublishedYear)" />
        </div>
      </div>

      <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Uppdatera bok</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEditBook">Avbryt</button>
      </div>
    </EditForm>
  </section>
}

@if (!string.IsNullOrWhiteSpace(bookMessage))
{
  <div class="alert alert-success" role="alert">
    @bookMessage
  </div>
}

@if (!string.IsNullOrWhiteSpace(bookError))
{
  <div class="alert alert-danger" role="alert">
    @bookError
  </div>
}

@if (books is null)
{
  <p>Laddar böcker...</p>
}
else if (!books.Any())
{
  <p>Inga böcker matchar sökningen.</p>
}
else
{
  <section class="mb-4">
    <h2 class="section-title">Kortvy</h2>
    <div class="row g-3">
      @foreach (var book in books)
      {
        <div class="col-md-6 col-xl-4">
          <BookCard Book="book" />
        </div>
      }
    </div>
  </section>

  <section>
    <h2 class="section-title">Tabellvy</h2>

    <div class="table-shell">
      <table class="table">
        <thead>
          <tr>
            <th>
              <button class="btn btn-link p-0" @onclick="() => SortBooks(nameof(Book.ISBN))">
                ISBN
              </button>
            </th>
            <th>
              <button class="btn btn-link p-0" @onclick="() => SortBooks(nameof(Book.Title))">
                Titel
              </button>
            </th>
            <th>
              <button class="btn btn-link p-0" @onclick="() => SortBooks(nameof(Book.Author))">
                Författare
              </button>
            </th>
            <th>
              <button class="btn btn-link p-0" @onclick="() => SortBooks(nameof(Book.PublishedYear))">
                År
              </button>
            </th>
            <th>
              <button class="btn btn-link p-0" @onclick="() => SortBooks(nameof(Book.IsAvailable))">
                Status
              </button>
            </th>
            <th>Åtgärd</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var book in books)
          {
            <tr>
              <td>@book.ISBN</td>
              <td>
                <a href="/books/@book.Id">@book.Title</a>
              </td>
              <td>@book.Author</td>
              <td>@book.PublishedYear</td>
              <td>@(book.IsAvailable ? "Tillgänglig" : "Utlånad")</td>
              <td>
                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEditBook(book)">
                  Redigera
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleDeleteBook(book.Id)">
                  Ta bort
                </button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
}

@code {
  private List<Book>? books;
  private string searchTerm = string.Empty;
  private string currentSortColumn = nameof(Book.Title);
  private bool sortAscending = true;
  private AddBookFormModel newBook = new();
  private EditBookFormModel editBook = new();
  private bool isEditingBook;
  private string? bookMessage;
  private string? bookError;

  private class AddBookFormModel
  {
    [Required(ErrorMessage = "ISBN är obligatoriskt.")]
    public string ISBN { get; set; } = string.Empty;

    [Required(ErrorMessage = "Titel är obligatorisk.")]
    public string Title { get; set; } = string.Empty;

    [Required(ErrorMessage = "Författare är obligatorisk.")]
    public string Author { get; set; } = string.Empty;

    [Range(1000, 2100, ErrorMessage = "Ange ett giltigt utgivningsår.")]
    public int PublishedYear { get; set; }
  }

  private class EditBookFormModel
  {
    public int Id { get; set; }

    [Required(ErrorMessage = "ISBN är obligatoriskt.")]
    public string ISBN { get; set; } = string.Empty;

    [Required(ErrorMessage = "Titel är obligatorisk.")]
    public string Title { get; set; } = string.Empty;

    [Required(ErrorMessage = "Författare är obligatorisk.")]
    public string Author { get; set; } = string.Empty;

    [Range(1000, 2100, ErrorMessage = "Ange ett giltigt utgivningsår.")]
    public int PublishedYear { get; set; }
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadAllBooks();
  }

  private async Task LoadAllBooks()
  {
    searchTerm = string.Empty;
    books = (await BookRepository.GetAllAsync()).ToList();
  }

  private async Task HandleSearch()
  {
    books = (await BookRepository.SearchAsync(searchTerm)).ToList();
  }

  private void SortBooks(string column)
  {
    if (books is null)
      return;

    if (currentSortColumn == column)
    {
      sortAscending = !sortAscending;
    }
    else
    {
      currentSortColumn = column;
      sortAscending = true;
    }

    books = column switch
    {
      nameof(Book.ISBN) => sortAscending
          ? books.OrderBy(b => b.ISBN).ToList()
          : books.OrderByDescending(b => b.ISBN).ToList(),

      nameof(Book.Title) => sortAscending
          ? books.OrderBy(b => b.Title).ToList()
          : books.OrderByDescending(b => b.Title).ToList(),

      nameof(Book.Author) => sortAscending
          ? books.OrderBy(b => b.Author).ToList()
          : books.OrderByDescending(b => b.Author).ToList(),

      nameof(Book.PublishedYear) => sortAscending
          ? books.OrderBy(b => b.PublishedYear).ToList()
          : books.OrderByDescending(b => b.PublishedYear).ToList(),

      nameof(Book.IsAvailable) => sortAscending
          ? books.OrderBy(b => b.IsAvailable).ToList()
          : books.OrderByDescending(b => b.IsAvailable).ToList(),

      _ => books
    };
  }

  private async Task HandleAddBook()
  {
    bookError = null;
    bookMessage = null;

    try
    {
      var book = new Book(
        newBook.ISBN,
        newBook.Title,
        newBook.Author,
        newBook.PublishedYear);

      await BookRepository.AddAsync(book);

      bookMessage = "Boken sparades.";
      newBook = new AddBookFormModel();
      await LoadAllBooks();
    }
    catch (InvalidOperationException ex)
    {
      bookError = ex.Message;
    }
    catch (Exception)
    {
      bookError = "Ett oväntat fel uppstod när boken skulle sparas.";
    }
  }

  private void StartEditBook(Book book)
  {
    isEditingBook = true;
    bookMessage = null;
    bookError = null;
    editBook = new EditBookFormModel
    {
      Id = book.Id,
      ISBN = book.ISBN,
      Title = book.Title,
      Author = book.Author,
      PublishedYear = book.PublishedYear
    };
  }

  private void CancelEditBook()
  {
    isEditingBook = false;
    editBook = new EditBookFormModel();
    bookMessage = null;
    bookError = null;
  }

  private async Task HandleUpdateBook()
  {
    bookError = null;
    bookMessage = null;

    try
    {
      var book = await BookRepository.GetByIdAsync(editBook.Id);
      if (book is null)
        throw new InvalidOperationException("Boken kunde inte hittas.");

      book.UpdateDetails(editBook.ISBN, editBook.Title, editBook.Author, editBook.PublishedYear);

      await BookRepository.UpdateAsync(book);

      bookMessage = "Boken uppdaterades.";
      isEditingBook = false;
      editBook = new EditBookFormModel();
      await LoadAllBooks();
    }
    catch (InvalidOperationException ex)
    {
      bookError = ex.Message;
    }
    catch (Exception)
    {
      bookError = "Ett oväntat fel uppstod när boken skulle uppdateras.";
    }
  }

  private async Task HandleDeleteBook(int id)
  {
    bookError = null;
    bookMessage = null;

    try
    {
      await BookRepository.DeleteAsync(id);
      bookMessage = "Boken togs bort.";

      if (isEditingBook && editBook.Id == id)
        CancelEditBook();

      await LoadAllBooks();
    }
    catch (InvalidOperationException ex)
    {
      bookError = ex.Message;
    }
    catch (Exception)
    {
      bookError = "Ett oväntat fel uppstod när boken skulle tas bort.";
    }
  }
}

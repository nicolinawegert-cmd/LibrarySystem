@page "/books"
@inject IBookRepository BookRepository

<PageTitle>Böcker</PageTitle> 

<h1>Böcker</h1>

<div class="mb-3">
  <label for="searchTerm" class="form-label">Sök bok</label>
  <InputText id="searchTerm" class="form-control" @bind-Value="searchTerm" />
</div>

<button class="btn btn-primary mb-2" @onclick="HandleSearch">Sök</button>
<button class="btn btn-secondary" @onclick="LoadAllBooks">Visa alla</button>

@if (books is null)
{
  <p>Laddar böcker...</p>
}
else if (!books.Any())
{
  <p>Det finns inga böcker i databasen ännu</p>
}
else
{
  <table class="table">
    <thead>
      <tr>
        <th>ISBN</th>
        <th>Titel</th>
        <th>Författare</th>
        <th>År</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var book in books)
      {
        <tr>
          <td>@book.ISBN</td>
          <td>@book.Title</td>
          <td>@book.Author</td>
          <td>@book.PublishedYear</td>
          <td>@(book.IsAvailable ? "Tillgänglig" : "Utlånad")</td>
        </tr>
      }
    </tbody>
  </table>
}

@code {
  private IEnumerable<Book>? books;
  private string searchTerm = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    await LoadAllBooks();
  }

  private async Task LoadAllBooks()
  {
    books = await BookRepository.GetAllAsync();
  }
  
  private async Task HandleSearch()
  {
    books = await BookRepository.SearchAsync(searchTerm);
  }
}
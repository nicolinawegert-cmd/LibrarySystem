@page "/loans"
@inject LibraryContext Db
@inject LoanService LoanService

<PageTitle>Utlåning</PageTitle>

<div class="page-heading">
  <h1>Utlåning</h1>
  <p>Skapa nya lån, följ förfallodatum och hantera aktiva och avslutade lån.</p>
</div>

<section class="form-shell mb-4">
  <h2 class="section-title">Skapa nytt lån</h2>
  <p class="section-subtitle">Välj en tillgänglig bok och koppla den till en medlem.</p>

  <EditForm Model="@newLoan" OnValidSubmit="HandleCreateLoan" FormName="CreateLoanForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
      <div class="col-md-6">
        <label for="book" class="form-label">Bok</label>
        <InputSelect id="book" class="form-select" @bind-Value="newLoan.BookId">
          <option value="0">Välj en bok</option>
          @foreach (var book in availableBooks)
          {
            <option value="@book.Id">@book.Title</option>
          }
        </InputSelect>
        <ValidationMessage For="@(() => newLoan.BookId)" />
      </div>

      <div class="col-md-6">
        <label for="member" class="form-label">Medlem</label>
        <InputSelect id="member" class="form-select" @bind-Value="newLoan.MemberId">
          <option value="0">Välj en medlem</option>
          @foreach (var member in members)
          {
            <option value="@member.Id">@member.Name</option>
          }
        </InputSelect>
        <ValidationMessage For="@(() => newLoan.MemberId)" />
      </div>
    </div>

    <div class="mt-3">
      <button type="submit" class="btn btn-primary">Skapa lån</button>
    </div>
  </EditForm>
</section>

@if (isEditingLoan)
{
  <section class="form-shell mb-4">
    <h2 class="section-title">Redigera lån</h2>
    <p class="section-subtitle">Justera förfallodatum för ett aktivt lån.</p>

    <EditForm Model="@editLoan" OnValidSubmit="HandleUpdateLoan" FormName="EditLoanForm">
      <DataAnnotationsValidator />
      <ValidationSummary />

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Förfallodatum</label>
          <InputDate class="form-control" @bind-Value="editLoan.DueDate" />
          <ValidationMessage For="@(() => editLoan.DueDate)" />
        </div>
      </div>

      <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Uppdatera lån</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEditLoan">Avbryt</button>
      </div>
    </EditForm>
  </section>
}

@if (!string.IsNullOrWhiteSpace(message))
{
  <div class="alert alert-success" role="alert">
    @message
  </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
  <div class="alert alert-danger" role="alert">
    @errorMessage
  </div>
}

@if (!activeLoans.Any())
{
  <p>Det finns inga aktiva lån.</p>
}
else
{
  <section class="mb-4">
    <h2 class="section-title">Aktiva lån</h2>

    <div class="table-shell">
      <table class="table">
        <thead>
          <tr>
            <th>Bok</th>
            <th>Medlem</th>
            <th>Lånedatum</th>
            <th>Förfallodatum</th>
            <th>Status</th>
            <th>Åtgärd</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var loan in activeLoans)
          {
            var isOverdue = loan.DueDate.Date < DateTime.UtcNow.Date;

            <tr>
              <td>@loan.Book?.Title</td>
              <td>@loan.Member?.Name</td>
              <td>@loan.LoanDate.ToShortDateString()</td>
              <td>@loan.DueDate.ToShortDateString()</td>
              <td>@(isOverdue ? "Försenad" : "Aktiv")</td>
              <td>
                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEditLoan(loan)">
                  Redigera
                </button>
                <button class="btn btn-sm btn-outline-success" @onclick="() => HandleReturnLoan(loan.Id)">
                  Returnera
                </button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
}

@if (returnedLoans.Any())
{
  <section>
    <h2 class="section-title">Avslutade lån</h2>

    <div class="table-shell">
      <table class="table">
        <thead>
          <tr>
            <th>Bok</th>
            <th>Medlem</th>
            <th>Lånedatum</th>
            <th>Returnerad</th>
            <th>Åtgärd</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var loan in returnedLoans)
          {
            <tr>
              <td>@loan.Book?.Title</td>
              <td>@loan.Member?.Name</td>
              <td>@loan.LoanDate.ToShortDateString()</td>
              <td>@loan.ReturnDate?.ToShortDateString()</td>
              <td>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleDeleteLoan(loan.Id)">
                  Ta bort
                </button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
}

@code {
  private List<Book> availableBooks = new();
  private List<Member> members = new();
  private List<Loan> activeLoans = new();
  private List<Loan> returnedLoans = new();
  private CreateLoanFormModel newLoan = new();
  private EditLoanFormModel editLoan = new();
  private bool isEditingLoan;

  private string? message;
  private string? errorMessage;

  private class CreateLoanFormModel
  {
    [Range(1, int.MaxValue, ErrorMessage = "Välj en bok.")]
    public int BookId { get; set; }

    [Range(1, int.MaxValue, ErrorMessage = "Välj en medlem.")]
    public int MemberId { get; set; }
  }

  private class EditLoanFormModel
  {
    public int Id { get; set; }

    [Required(ErrorMessage = "Förfallodatum är obligatoriskt.")]
    public DateTime DueDate { get; set; }
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadPageData();
  }

  private async Task LoadPageData()
  {
    availableBooks = await Db.Books
      .Where(b => b.IsAvailable)
      .OrderBy(b => b.Title)
      .ToListAsync();

    members = await Db.Members
      .OrderBy(m => m.Name)
      .ToListAsync();

    activeLoans = await Db.Loans
      .Include(l => l.Book)
      .Include(l => l.Member)
      .Where(l => l.ReturnDate == null)
      .OrderBy(l => l.DueDate)
      .ToListAsync();

    returnedLoans = await Db.Loans
      .Include(l => l.Book)
      .Include(l => l.Member)
      .Where(l => l.ReturnDate != null)
      .OrderByDescending(l => l.ReturnDate)
      .ToListAsync();
  }

  private async Task HandleCreateLoan()
  {
    message = null;
    errorMessage = null;

    try
    {
      await LoanService.BorrowAsync(newLoan.BookId, newLoan.MemberId);

      message = "Lånet har skapats!";
      newLoan = new CreateLoanFormModel();

      await LoadPageData();
    }
    catch (InvalidOperationException ex)
    {
      errorMessage = ex.Message;
    }
    catch (Exception)
    {
      errorMessage = "Ett oväntat fel inträffade när lånet skulle skapas.";
    }
  }

  private void StartEditLoan(Loan loan)
  {
    isEditingLoan = true;
    message = null;
    errorMessage = null;
    editLoan = new EditLoanFormModel
    {
      Id = loan.Id,
      DueDate = loan.DueDate.Date
    };
  }

  private void CancelEditLoan()
  {
    isEditingLoan = false;
    editLoan = new EditLoanFormModel();
    message = null;
    errorMessage = null;
  }

  private async Task HandleUpdateLoan()
  {
    message = null;
    errorMessage = null;

    try
    {
      await LoanService.UpdateDueDateAsync(editLoan.Id, editLoan.DueDate);
      message = "Lånet uppdaterades.";
      isEditingLoan = false;
      editLoan = new EditLoanFormModel();
      await LoadPageData();
    }
    catch (InvalidOperationException ex)
    {
      errorMessage = ex.Message;
    }
    catch (Exception)
    {
      errorMessage = "Ett oväntat fel uppstod när lånet skulle uppdateras.";
    }
  }

  private async Task HandleReturnLoan(int loanId)
  {
    message = null;
    errorMessage = null;

    try
    {
      await LoanService.ReturnAsync(loanId);

      message = "Boken har återlämnats!";

      if (isEditingLoan && editLoan.Id == loanId)
        CancelEditLoan();

      await LoadPageData();
    }
    catch (InvalidOperationException ex)
    {
      errorMessage = ex.Message;
    }
    catch (Exception)
    {
      errorMessage = "Ett oväntat fel uppstod när lånet skulle returneras.";
    }
  }

  private async Task HandleDeleteLoan(int loanId)
  {
    message = null;
    errorMessage = null;

    try
    {
      await LoanService.DeleteAsync(loanId);
      message = "Lånet togs bort.";
      await LoadPageData();
    }
    catch (InvalidOperationException ex)
    {
      errorMessage = ex.Message;
    }
    catch (Exception)
    {
      errorMessage = "Ett oväntat fel uppstod när lånet skulle tas bort.";
    }
  }
}

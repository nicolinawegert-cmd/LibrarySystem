@page "/loans"
@inject LibraryContext Db
@inject LoanService LoanService

<PageTitle>Utlåning</PageTitle>

<h1>Utlåning</h1>

<EditForm Model="@newLoan" OnValidSubmit="HandleCreateLoan" FormName="CreateLoanForm">
  <DataAnnotationsValidator />
  <ValidationSummary />

  <div class="mb-3">
    <label for="book" class="form-label">Bok</label>
    <InputSelect id="book" class="form-select" @bind-Value="newLoan.BookId">
      <option value="0">Välj en bok</option>
      @foreach (var book in availableBooks)
      {
        <option value="@book.Id">@book.Title</option>
      }
    </InputSelect>
    <ValidationMessage For="@(() => newLoan.BookId)" />
  </div>

  <div class="mb-3">
    <label for="member" class="form-label">Medlem</label>
    <InputSelect id="member" class="form-select" @bind-Value="newLoan.MemberId">
      <option value="0">Välj en medlem</option>
      @foreach (var member in members)
      {
        <option value="@member.Id">@member.Name</option>
      }
    </InputSelect>
    <ValidationMessage For="@(() => newLoan.MemberId)" />
  </div>

  <button type="submit" class="btn btn-primary">Skapa lån</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(message))
{
  <div class="alert alert-success" role="alert">
    @message
  </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
  <div class="alert alert-danger" role="alert">
    @errorMessage
  </div>
}


<h2>Aktiva lån</h2>

@if (!activeLoans.Any())
{
  <p>Det finns inga aktiva lån.</p>
}
else
{
  <div class="table-shell">
    <table class="table">
      <thead>
        <tr>
          <th>Bok</th>
          <th>Medlem</th>
          <th>Lånedatum</th>
          <th>Förfallodatum</th>
          <th>Status</th>
          <th>Åtgärd</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var loan in activeLoans)
        {
          var isOverdue = loan.DueDate.Date < DateTime.UtcNow.Date;

          <tr>
            <td>@loan.Book?.Title</td>
            <td>@loan.Member?.Name</td>
            <td>@loan.LoanDate.ToShortDateString()</td>
            <td>@loan.DueDate.ToShortDateString()</td>
            <td>@(isOverdue ? "Försenad" : "Aktiv")</td>
            <td>
              <button class="btn btn-sm btn-outline-success" @onclick="() => HandleReturnLoan(loan.Id)">
                Returnera
              </button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

@code {
  private List<Book> availableBooks = new();
  private List<Member> members = new();
  private List<Loan> activeLoans = new();
  private CreateLoanFormModel newLoan = new();

  private string? message;
  private string? errorMessage;

  private class CreateLoanFormModel
  {
    [Range(1, int.MaxValue, ErrorMessage = "Välj en bok.")]
    public int BookId { get; set; }

    [Range(1, int.MaxValue, ErrorMessage = "Välj en medlem.")]
    public int MemberId { get; set; }
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadPageData();
  }

  private async Task LoadPageData()
  {
    availableBooks = await Db.Books
      .Where(b => b.IsAvailable)
      .OrderBy(b => b.Title)
      .ToListAsync();

    members = await Db.Members
      .OrderBy(m => m.Name)
      .ToListAsync();

    activeLoans = await Db.Loans
      .Include(l => l.Book)
      .Include(l => l.Member)
      .Where(l => l.ReturnDate == null)
      .OrderBy(l => l.DueDate)
      .ToListAsync();
  }

  private async Task HandleCreateLoan()
  {
    message = null;
    errorMessage = null;

    try 
    {
      await LoanService.BorrowAsync(newLoan.BookId, newLoan.MemberId);

      message = "Lånet har skapats!";
      newLoan = new CreateLoanFormModel();

      await LoadPageData();
    }
    catch (InvalidOperationException ex)
    {
      errorMessage = ex.Message;
    }
    catch (Exception)
    {
      errorMessage = "Ett oväntat fel inträffade när lånet skulle skapas.";
    }
  }
  private async Task HandleReturnLoan(int loanId)
  {
    message = null;
    errorMessage = null;

    try
    {
      await LoanService.ReturnAsync(loanId);

      message = "Boken har återlämnats!";
      await LoadPageData();
    }
    catch (InvalidOperationException ex)
    {
      errorMessage = ex.Message;
    }
    catch (Exception)
    {
      errorMessage = "Ett oväntat fel uppstod när lånet skulle returneras.";
    }
  }
}


@page "/"
@inject LibraryContext Db

<PageTitle>Startsida</PageTitle>

<section class="hero-panel mb-4">
    <h1>Bibliotekssystem</h1>
    <p>Hantera böcker, medlemmar och utlåning i ett gemensamt webbgränssnitt.</p>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3">
            <h2>@totalBooks</h2>
            <p>Totalt antal böcker</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h2>@availableBooks</h2>
            <p>Tillgängliga böcker</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h2>@totalMembers</h2>
            <p>Medlemmar</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h2>@activeLoans</h2>
            <p>Aktiva lån</p>
        </div>
    </div>

    <section class="quick-links">
        <h2>Snabbnavigering</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <a class="quick-link-card" href="/books">Böcker</a>
            </div>
            <div class="col-md-4">
                <a class="quick-link-card" href="/members">Medlemmar</a>
            </div>
            <div class="col-md-4">
                <a class="quick-link-card" href="/loans">Utlåning</a>
            </div>
        </div>
    </section>
</div>

<h2>Gå vidare</h2>
<ul>
    <li><NavLink href="books">Böcker</NavLink></li>
    <li><NavLink href="members">Medlemmar</NavLink></li>
    <li><NavLink href="loans">Utlåning</NavLink></li>
</ul>

@code {
    private int totalBooks;
    private int availableBooks;
    private int totalMembers;
    private int activeLoans;

    protected override async Task OnInitializedAsync()
    {
        totalBooks = await Db.Books.CountAsync();
        availableBooks = await Db.Books.CountAsync(b => b.IsAvailable);
        totalMembers = await Db.Members.CountAsync();
        activeLoans = await Db.Loans.CountAsync(l => l.ReturnDate == null);
    }   
}